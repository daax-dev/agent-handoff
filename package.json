{
  "name": "@daax-dev/agent-handoff",
  "version": "0.1.0",
  "description": "MCP server for cross-agent task delegation — hand off work between AI coding agents (Claude, Codex, Gemini, Copilot, OpenCode) via CLI spawn or A2A protocol",
  "author": "Peregrine Summit",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-handoff": "dist/cli/localsdlc.js",
    "localsdlc": "dist/cli/localsdlc.js",
    "agent-handoff-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/daax-dev/agent-handoff.git"
  },
  "homepage": "https://github.com/daax-dev/agent-handoff#readme",
  "bugs": {
    "url": "https://github.com/daax-dev/agent-handoff/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "dev:web": "bash scripts/dev-web.sh",
    "dev:api": "bun run src/api/server.ts",
    "dev:ui": "bun --cwd ui run dev",
    "build": "tsc && { printf '#!/usr/bin/env bun\\n'; cat dist/index.js; } > dist/index.js.tmp && mv dist/index.js.tmp dist/index.js && chmod +x dist/index.js && { printf '#!/usr/bin/env node\\n'; tail -n +2 dist/cli/localsdlc.js; } > dist/cli/localsdlc.js.tmp && mv dist/cli/localsdlc.js.tmp dist/cli/localsdlc.js && chmod +x dist/cli/localsdlc.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bun": "bun run test",
    "test:api": "bun test src/__tests__/api.test.ts",
    "verify-provenance": "bun run scripts/verify-provenance.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.5.2",
    "vitest": "^3.2.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
