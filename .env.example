# Copy to .env.local and edit — .env.local is never committed.

# API server port (auto-detected from 4000–4009 if unset)
PORT=4000

# SQLite database path (default: .work/agent-handoff.db)
# DB_PATH=/absolute/path/to/agent-handoff.db

# Set by dev-web.sh — Vite reads this to proxy /api to the actual API port
# VITE_API_PORT=4000

# Set by dev-web.sh — Vite dev server port
# VITE_UI_PORT=5173
